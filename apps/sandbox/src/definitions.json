          "close": "]",
          "separator": ", ",
          "quote": "'"
        }
      },
      "empty": {
        "Number": {
          "shadow": "math_number",
          "fieldValues": {
            "NUM": "0"
          }
        },
        "String": {
          "shadow": "text",
          "fieldValues": {
            "TEXT": "text"
          }
        },
        "Boolean": {
          "shadow": "m_logic_boolean",
          "fieldValues": {
            "BOOL": "true"
          }
        }
      },
      "highlighting": {
        "keywords": [
          "if",
          "elif",
          "else",
          "for",
          "while",
          "in",
          "and",
          "or",
          "not",
          "True",
          "False",
          "None",
          "def",
          "return",
          "print",
          "range",
          "pass"
        ],
        "strings": [
          "\"",
          "'"
        ],
        "comment": "#",
