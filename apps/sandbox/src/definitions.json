    {
      "name": "concept-tiles",
      "elements": [
        "title",
        "concept"
      ]
    },
    {
      "name": "python-tiles",
      "elements": [
        "title",
        "python"
      ],
      "render": {
        "python": "text-based"
      }
    },
    {
      "name": "js-tiles",
      "elements": [
        "title",
        "javascript"
      ]
    },
    {
      "name": "concept-python-tiles",
      "elements": [
        "title",
        "concept",
        "python"
      ],
      "render": {
        "concept": "block-based",
        "python": "text-based"
      }
    },
    {
      "name": "all-code-tiles",
      "elements": [
        "title",
        "concept",
        "python",
        "javascript",
        "go"
      ],
      "render": {
        "concept": "block-based",
        "python": "block-based",
        "javascript": "text-based",
        "go": "text-based"
      }
    }
