        },
        "String": {
          "shadow": "text",
          "fieldValues": {
            "TEXT": "text"
          }
        },
        "Boolean": {
          "shadow": "m_logic_boolean",
          "fieldValues": {
            "BOOL": "true"
          }
        }
      },
      "highlighting": {
        "keywords": [
          "if",
          "else",
          "while",
          "repeat",
          "for",
          "Output",
          "اطبع"
        ],
        "strings": [
          "\""
        ],
        "comment": "//"
      }
    },
    "python": {
      "types": {
        "Number": "float",
        "String": "str",
        "Boolean": "bool",
        "default": "object"
      },
      "stringQuote": "\"",
      "emptyStatement": "pass",
      "values": {
        "true": "True",
        "false": "False",
        "null": "None",
        "undefined": "None",
        "NaN": "nan",
        "Infinity": "inf",
        "-Infinity": "-inf",
