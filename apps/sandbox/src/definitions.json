  "blocks": [
    {
      "identifier": "text_print",
      "category": "Output",
      "elements": {
        "icon": "icons/text_print.svg",
        "title": "Print",
        "description": "Prints a value to the console",
        "concept": "Output %1",
        "python": "print(%1)",
        "javascript": "console.log(%1);",
        "go": "fmt.Println(%1)",
        "info": "Writes a value to the output",
        "spoken": "Print block: writes a value to the output"
      },
      "inputSlots": {
        "1": {
          "kind": "value",
          "name": "TEXT",
          "check": [
            "String",
            "Number",
            "Boolean"
          ],
          "default": {
            "shadow": "text_value",
            "fieldValues": {
              "TEXT": "Hello, world!"
            }
          }
        }
      },
      "shape": "statement",
      "inputsInline": true
    },
    {
      "identifier": "logic_if",
      "category": "Control",
      "elements": {
        "icon": "icons/logic_if.svg",
        "title": "If / Then",
        "description": "Runs code when a condition is true",
        "concept": "Condition %1 Then %2",
        "python": "if %1:\n    %2",
        "javascript": "if (%1) {\n  %2\n}",
        "go": "if %1 {\n    %2\n}"
      },
      "inputSlots": {
        "1": {
          "kind": "value",
          "name": "CONDITION",
          "check": "Boolean"
        },
        "2": {
          "kind": "statement",
          "name": "DO"
        }
      },
      "shape": "statement",
      "inputsInline": true
    },
    {
      "identifier": "loop_for",
      "category": "Control",
      "elements": {
        "icon": "icons/loop_for.svg",
        "title": "Repeat",
        "description": "Runs code a set number of times",
        "concept": "Repeat %1 times %2",
        "python": "for i in range(%1):\n    %2",
        "javascript": "for (let i = 0; i < %1; i++) {\n  %2\n}",
        "go": "for i := 0; i < %1; i++ {\n    %2\n}"
      },
      "inputSlots": {
        "1": {
          "kind": "value",
          "name": "TIMES",
          "check": "Number"
        },
        "2": {
          "kind": "statement",
          "name": "DO"
        }
      },
      "shape": "statement",
      "inputsInline": true
    },
