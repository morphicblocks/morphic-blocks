{
  "elementTypes": {
    "title": "text",
    "code": "code"
  },
  "code": {
    "code": {
      "stringQuote": "\"",
      "empty": { "Number": { "shadow": "math_number", "fieldValues": { "NUM": "0" } } },
      "highlighting": { "keywords": ["print"], "strings": ["\"", ["„", "“"]] }
    }
  },
  "modes": [
    { "name": "only", "elements": ["title", "code"] },
    { "name": "only-text", "elements": ["title", "code"], "render": { "code": "text-based" } }
  ],
  "views": {
    "workspace": "workspace",
    "codespace": "codespace",
    "preview": { "kind": "codespace", "editable": false }
  },
  "presets": [
    { "name": "blocks", "toolbox": "only", "views": { "workspace": "only" } },
    { "name": "text", "toolbox": "only-text", "views": { "codespace": "only", "preview": "only" } }
  ],
  "blocks": [
    {
      "identifier": "say",
      "elements": { "title": "Say", "code": "say(%1)" },
      "inputSlots": { "1": { "kind": "value", "name": "VALUE", "default": { "shadow": "text", "fieldValues": { "TEXT": "hi" } } } },
      "shape": "statement"
    },
    {
      "identifier": "math",
      "elements": { "code": "%1 %OP %2" },
      "inputSlots": {
        "1": { "kind": "value", "name": "A", "check": "Number" },
        "2": { "kind": "value", "name": "B", "check": "Number", "default": { "placeholder": "math_number", "fieldValues": { "NUM": "5" } } }
      },
      "fields": { "OP": { "type": "dropdown", "options": ["+", ["*", "×"], { "value": "&&", "display": { "code": "and" } }] } },
      "output": true
    },
    { "identifier": "number", "elements": { "code": "%NUM" }, "fields": { "NUM": { "type": "number", "default": 0 } }, "output": "Number" }
  ]
}
