{
  "name": "morphic-blocks",
  "version": "0.1.0",
  "description": "Mode-driven wrapper framework around Google Blockly",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morphicblocks/morphic-blocks.git",
    "directory": "packages/morphic-blocks"
  },
  "homepage": "https://github.com/morphicblocks/morphic-blocks#readme",
  "bugs": "https://github.com/morphicblocks/morphic-blocks/issues",
  "type": "module",
  "main": "./dist/morphic-blocks.umd.cjs",
  "module": "./dist/morphic-blocks.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/morphic-blocks.js",
      "require": "./dist/morphic-blocks.umd.cjs"
    }
  },
  "files": [
    "dist",
    "definitions.schema.json",
    "NOTICE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "keywords": [
    "blockly",
    "framework",
    "visual-programming",
    "morphic"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "blockly": "^11.2.2"
  },
  "peerDependencies": {
    "@codemirror/lang-javascript": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/lang-javascript": { "optional": true },
    "@codemirror/state": { "optional": true },
    "@codemirror/view": { "optional": true }
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
