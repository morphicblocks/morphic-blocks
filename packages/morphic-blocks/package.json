{
  "name": "morphic-blocks",
  "version": "0.3.0",
  "description": "Mode-driven wrapper framework around Google Blockly",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morphicblocks/morphic-blocks.git",
    "directory": "packages/morphic-blocks"
  },
  "homepage": "https://morphicblocks.com",
  "bugs": "https://github.com/morphicblocks/morphic-blocks/issues",
  "type": "module",
  "main": "./dist/morphic-blocks.umd.cjs",
  "module": "./dist/morphic-blocks.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "morphic-blocks": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/morphic-blocks.js",
      "require": "./dist/morphic-blocks.umd.cjs"
    }
  },
  "files": [
    "dist",
    "definitions.schema.json",
    "NOTICE"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.cli.config.ts && tsc -p tsconfig.build.json && tsc -p cli",
    "test": "vitest run"
  },
  "keywords": [
    "morphic-blocks",
    "blockly",
    "block-based-programming",
    "text-based-programming",
    "visual-programming",
    "programming-education",
    "codemirror"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "blockly": "^11.2.2"
  },
  "peerDependencies": {
    "@codemirror/lang-javascript": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/lang-javascript": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@types/node": "^26.6.3",
    "jsdom": "25.0.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.1"
  }
}
