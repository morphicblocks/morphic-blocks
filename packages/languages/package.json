{
  "name": "@morphicblocks/languages",
  "version": "0.1.0",
  "description": "Languages for Morphic Blocks: how Python, JavaScript, Java, Go, Rust and C++ write the standard blocks, with their settings",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morphicblocks/morphic-blocks.git",
    "directory": "packages/languages"
  },
  "homepage": "https://morphicblocks.com",
  "bugs": "https://github.com/morphicblocks/morphic-blocks/issues",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "keywords": [
    "morphic-blocks",
    "languages",
    "python",
    "javascript",
    "java",
    "go",
    "rust",
    "cpp"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@morphicblocks/blocks": ">=0.1.0",
    "morphic-blocks": ">=0.4.0"
  },
  "devDependencies": {
    "@morphicblocks/blocks": "workspace:*",
    "blockly": "^11.2.2",
    "jsdom": "25.0.1",
    "morphic-blocks": "workspace:*",
    "typescript": "^5.8.2",
    "vitest": "^5.0.1"
  }
}
